<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] -ConReg</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootswatch/5.3.8/pulse/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FilaDeCampo.styles.css" asp-append-version="true" />

    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }

</head>

<body>
    @{
        var estaLogado = User.Identity?.IsAuthenticated == true;
        var perfil = estaLogado ? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value : null;
        var nomeUsuario = estaLogado ? Context.Session.GetString("NomeUsuario") : "";
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-3">
            <div class="container-fluid">
                <form method="post" asp-controller="Congregacao" asp-action="Logout" class="d-inline">
                    <button type="submit" class="btn btn-link navbar-brand p-0"
                            style="color:white; text-decoration:none;">
                        CONREG
                    </button>
                </form>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                        aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarCollapse">

                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        @if (estaLogado)
                        {
                            @* Abas do Master *@
                            @if (perfil?.Equals("Master", StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Congregacao" asp-action="DashboardMaster">
                                        Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Congregacao" asp-action="Criar">
                                        Criar Congregação
                                    </a>
                                </li>
                            }
                            @*Sessao para as Congregacoes*@
                            else if (perfil?.Equals("Congregacao", StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Escala" asp-action="Index">
                                        Campo Sabados
                                    </a>
                                </li>
                               @* <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="" asp-action="">
                                        Indicadores
                                    </a>
                                </li>*@

                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="" asp-action="">
                                        Audio e Vídeo
                                    </a>
                                </li>

                                @*<li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Escala" asp-action="Index">
                                        Microfone Volante
                                    </a>
                                </li>*@
                            }
                        }
                    </ul>

                    @if (estaLogado)
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <form method="post" asp-controller="Congregacao" asp-action="Logout" class="d-flex">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill">
                                        Sair
                                    </button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container d-flex justify-content-between py-2">
            <span>&copy; 2025 - ConReg</span>
            <span><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> | v1.0</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("NToastNotify")

</body>

</html>