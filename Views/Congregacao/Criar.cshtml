@{
    ViewData["Title"] = "Criar Congregação";
}

<h2>Criar Congregação</h2>

<form method="post">
    <div class="form-group">
        <label>Nome da Congregação</label>
        <input type="text" name="nome" class="form-control" />
    </div>

    <div class="form-group mt-2">
        <label>Chave de Acesso</label>
        <input type="text" name="chaveAcesso" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-3 rounded-pill">Criar</button>
</form>

@if(TempData["Mensagem"] != null)
{
    <div class="alert alert-success mt-2">
        @TempData["Mensagem"]
    </div>
}

@if(!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mt-2">
        @Html.ValidationSummary()
    </div>
}
