@model FilaDeCampo.ViewModels.LoginMasterVM
@{
    ViewData["Title"] = "Login Master";
}

<!-- =============================================
     Styles: CSS terminal separado
     ============================================= -->
@section Styles {
    <link rel="stylesheet" href="~/css/login-master-terminal.css" />
}

<!-- =============================================
     Scripts: JS de erro estilo DOS
     ============================================= -->
@section Scripts {
    <script src="~/js/login-master-terminal.js"></script>

   <script>
        window.falhaLogin = !@ViewData.ModelState.IsValid.ToString().ToLower();
    </script>
}

<div class="container d-flex justify-content-center align-items-center" style="height: 100vh;">
    <div class="col-md-5">
        <div class="card terminal-card">
            <!-- HEADER -->
            <div class="card-header terminal-header">
                <h4 class="cursor">C:\ConReg\MASTER></h4>
                <small>*** ACESSO RESTRITO ***</small>
            </div>

            <!-- BODY -->
            <div class="card-body">
                <form asp-action="LoginMaster" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <!-- USUÁRIO -->
                    <div class="mb-3">
                        <label class="form-label">USUARIO</label>
                        <input asp-for="Usuario" class="form-control terminal-input" placeholder="Digite seu usuario"
                            required />
                        <span asp-validation-for="Usuario" class="text-danger"></span>
                    </div>

                    <!-- SENHA -->
                    <div class="mb-3">
                        <label class="form-label">SENHA</label>
                        <input asp-for="Senha" type="password" class="form-control terminal-input"
                            placeholder="Digite sua senha" required />
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>

                    <!-- BOTÃO LOGIN -->
                    <div class="d-grid mt-4">
                        <button type="submit" class="terminal-btn">
                            EXEC LOGIN
                        </button>
                    </div>
                </form>

                <!-- LOGS DO SISTEMA -->
                <div id="dos-log" class="dos-log mt-3"></div>

                <hr />

                <!-- VOLTAR -->
                <form id="voltarForm" method="post" asp-controller="Congregacao" asp-action="Logout">
                    <button type="submit" class="terminal-btn w-100 mt-3">
                        VOLTAR \\ LOGIN
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>