@{
    ViewData["Title"] = "Login Master";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header text-center">
                    <h4 class="mb-0">Fila de Campo</h4>
                    <small class="text-muted">Login Master</small>
                </div>
                <div class="card-body">
                    <form asp-action="LoginMaster" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input name="usuario" class="form-control" placeholder="Informe seu email" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Senha</label>
                            <input type="password" name="senha" class="form-control" placeholder="Informe sua senha" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Entrar como Master</button>
                        </div>
                    </form>

                    <hr />

                    <div class="mt-3 text-center">
                        <a class="btn btn-secondary" asp-controller="Congregacao" asp-action="Login">
                            Voltar ao login da congregação
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
